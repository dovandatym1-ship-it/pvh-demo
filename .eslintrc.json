{
  "extends": "next/core-web-vitals",
  "overrides": [
    {
      "files": ["src/app/(app)/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features/*/server/repository*",
                  "@/features/*/server/service*",
                  "@/lib/supabase/admin*",
                  "**/demo-context*",
                  "**/demo-state*"
                ],
                "message": "Route pages must only import actions, queries, or components. Repository and service imports are forbidden (ADR-002 §5)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/components/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features/*/server/service*",
                  "@/features/*/server/repository*",
                  "@/features/*/server/queries*",
                  "@/lib/supabase/*",
                  "**/demo-context*",
                  "**/demo-state*"
                ],
                "message": "Feature components must communicate via server actions, not direct service/repo/supabase imports (ADR-002 §5)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/server/actions.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features/*/server/repository*",
                  "@/lib/supabase/admin*",
                  "**/demo-context*",
                  "**/demo-state*"
                ],
                "message": "Server actions must delegate to service layer and cannot directly access repository (ADR-002 §5)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/server/service.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "next/*",
                  "@/lib/supabase/admin*",
                  "**/demo-context*",
                  "**/demo-state*"
                ],
                "message": "Service layer must remain pure TypeScript runtime-agnostic without Next.js or admin client (ADR-002 §5)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/server/repository.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/lib/supabase/admin*",
                  "**/demo-context*",
                  "**/demo-state*"
                ],
                "message": "Repository must use session user client; admin client is forbidden (ADR-002 §5)."
              }
            ]
          }
        ]
      }
    }
  ]
}
