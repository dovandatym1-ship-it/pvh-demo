# Next.js application (template only; never commit real credentials)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Deployment branding only (never used for Auth or RLS tenant identity).
NEXT_PUBLIC_ORGANIZATION_NAME=UBND xã mẫu
NEXT_PUBLIC_REGION_LABEL=Đơn vị hành chính cấp xã

# Canonical single-commune deployment. Real tenant identity comes from Auth + DB.
NEXT_PUBLIC_DEFAULT_TENANT=TN-DEMO-A

# Both flags may be set true ONLY for local `next dev` fixture testing.
# `next build` refuses NEXT_PUBLIC_DEMO_MODE=true.
NEXT_PUBLIC_DEMO_MODE=false
PVH_ALLOW_DEMO_AUTH=false
